				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OfferCodeDiscount">
				<xs:annotation>
					<xs:documentation xml:lang="en">A discount due to a provided offer code.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OnBoardAccommodation">
				<xs:annotation>
					<xs:documentation xml:lang="en">Cost for the onboard accommodations.</xs:documentation>
				</xs:annotation>
