	<xs:simpleType name="BookingStatusType">
		<xs:annotation>
			<xs:documentation xml:lang="en">Defines status of booking</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="Reserved">
				<xs:annotation>
					<xs:documentation xml:lang="en">
						Temporary reservation of space and price, will be cancelled automatically if not confirmed.
						Cancellation is not subject to cancellation fees.
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Booked">
				<xs:annotation>
					<xs:documentation xml:lang="en">
						Binding booking of sailing(s), usually subject to cancellation fees.
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Paid">
				<xs:annotation>
					<xs:documentation xml:lang="en">
						Booking was paid
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Partially Consumed">
				<xs:annotation>
					<xs:documentation xml:lang="en">

					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Fully Consumed">
				<xs:annotation>
					<xs:documentation xml:lang="en">

					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Cancelled">
				<xs:annotation>
					<xs:documentation xml:lang="en">
						Booking was cancelled.
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Readonly">
				<xs:annotation>
					<xs:documentation xml:lang="en">
						Booking cannot be modified through the FerryGateway API.
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>

