	<xs:simpleType name="CombinationRuleType">
		<xs:annotation>
			<xs:documentation xml:lang="en">Describes the rule for selecting individual Sailings from the current FerryComponent.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="None">
				<xs:annotation>
					<xs:documentation xml:lang="en">
						No Combination Rule. There is no option to select individual Sailings from the FerryComponent, only the entire FerryComponent can be selected.
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UseLegSetNumber">
				<xs:annotation>
					<xs:documentation xml:lang="en">
						The "Leg Set Number" combination rule should be used to select individual Sailings from the FerryComponent.
						Each Sailing should have a LegSetNumber attribute, and the requesting system should select one Sailing for each
						LegSetNumber attribute present in the FerryComponent (so that one of each LegSetNumber is present in the selected set of Sailings).
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="MandatoryFacilityType">
		<xs:annotation>
			<xs:documentation xml:lang="en">Enumerates facilities that are mandatory on a route and/or sailing.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="Vehicle">
				<xs:annotation>
					<xs:documentation xml:lang="en">
						Vehicle is required on the sailing.
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Meal">
				<xs:annotation>
					<xs:documentation xml:lang="en">
						It is necessary to order a meal on the sailing.
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Seating">
				<xs:annotation>
					<xs:documentation xml:lang="en">
						Passenger has to reserve a seat.
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Cabin">
				<xs:annotation>
					<xs:documentation xml:lang="en">
						Passenger has to book a cabin accommodation.
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Passport">
				<xs:annotation>
					<xs:documentation xml:lang="en">
						Passenger has to present a passport.
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="VISA">
				<xs:annotation>
					<xs:documentation xml:lang="en">
						Passenger needs to have valid VISA.
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="National Identity Card or Passport">
				<xs:annotation>
					<xs:documentation xml:lang="en">
						Passenger needs to present National Identity Card or Passport.
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EU Passenger Directive">
				<xs:annotation>
					<xs:documentation xml:lang="en">
						Prior to the departure of the vessel, passenger needs to provide in digital format
						-	Passenger First Name
						-	Passenger Last Name
						-	Passenger Gender (M/F)
						-	Passenger Date of Birth
						-	Passenger Nationality
						-	Passenger Mobile contact (Optional)
						-	Any disability information
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="MandatoryFacilitiesType">
		<xs:sequence>
			<xs:element name="MandatoryFacility" type="fgw:MandatoryFacilityType" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>

	<xs:simpleType name="PetTransportOptionsType">
