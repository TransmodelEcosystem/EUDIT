	<xs:complexType name="OnBoardAccommodationServiceOptionType">
		<xs:annotation>
			<xs:documentation xml:lang="en">
				Onboard accommodation service response. To assign passengers to multiple accommodations that have the same accommodation Code,
				the OnBoardAccommodationService element should be repeated for each accommodation item with that Code, with the quantity set to 1 in each case,
				and the PassengerRefs element should be populated for each of these separate OnBoardAccommodationService elements.
			</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="fgw:ServiceOptionType">
				<xs:sequence>
					<xs:element name="PassengerRefs" type="fgw:RefsType" minOccurs="0">
						<xs:key name="OnBoardAccommodationServiceOptionType_RefIdKey">
							<xs:selector xpath="fgw:Ref"/>
							<xs:field xpath="@Id"/>
						</xs:key>
					</xs:element>
					<xs:element name="Comment" type="xs:string" minOccurs="0" />
				</xs:sequence>
				<xs:attribute name="Berths" type="xs:unsignedInt" use="optional"/>
				<xs:attribute name="MaxAdults" type="xs:unsignedInt" use="optional"/>
				<xs:attribute name="MaxOccupancy" type="xs:unsignedInt" use="optional"/>
				<xs:attribute name="MinOccupancy" type="xs:unsignedInt" use="optional"/>
				<xs:attribute name="IsInfantsOK" type="xs:boolean" use="optional" default="false"/>
				<xs:attribute name="IsAccessible" type="xs:boolean" use="optional" default="false"/>
				<xs:attribute name="IsPetAllowed" type="xs:boolean" use="optional" default="false"/>
				<xs:attribute name="IsAllergyFriendly" type="xs:boolean" use="optional" default="false"/>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
