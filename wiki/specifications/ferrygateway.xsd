				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OtherDiscount">
				<xs:annotation>
					<xs:documentation xml:lang="en">Any other discount or rebate which may apply to the booking. Nature of the discount to be specified by Label attribute.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OtherTaxes">
				<xs:annotation>
					<xs:documentation xml:lang="en">Any other tax which may apply to the booking. Nature of the tax to be specified by label attribute.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PackageCost">
				<xs:annotation>
					<xs:documentation xml:lang="en">Cost for a package.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Passenger">
				<xs:annotation>
					<xs:documentation xml:lang="en">Cost for the passenger(s).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Pet">
				<xs:annotation>
					<xs:documentation xml:lang="en">Cost for the pet(s).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PortTaxes">
				<xs:annotation>
					<xs:documentation xml:lang="en">Port tax element of the booking.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ReturnTripDiscount">
				<xs:annotation>
					<xs:documentation xml:lang="en">A discount due to customer booking a return trip within the same operator.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TravelAgentDiscount">
				<xs:annotation>
					<xs:documentation xml:lang="en">A discount for Travel agents.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ValueAddedTax">
				<xs:annotation>
					<xs:documentation xml:lang="en">The VAT payable on the booking.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Vehicle">
				<xs:annotation>
					<xs:documentation xml:lang="en">Cost for the vehicle(s).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="VehicleAndPassenger">
				<xs:annotation>
					<xs:documentation xml:lang="en">Price for the vehicle and inclusive pax(es) for the booking.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
